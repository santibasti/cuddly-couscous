{
  "name": "topmop-ops",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:core": "rolldown src/lib/servercore.ts --format esm --platform neutral -o supabase/functions/_shared/appcore.mjs",
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:seed-sql": "vite-node scripts/export-seed-sql.ts",
    "build:card": "rolldown src/lib/cardserver.ts --format esm --platform neutral -o api/_cardcore.mjs",
    "chatsim": "node scripts/chatsim/scenarios.mjs",
    "chatsim:real": "node scripts/chatsim/realmodel.mjs"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@supabase/supabase-js": "^2.117.2",
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "motion": "14.10.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.3"
  }
}

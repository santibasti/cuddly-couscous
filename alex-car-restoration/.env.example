# Public site URL (used for canonical URLs, sitemap, structured data)
NEXT_PUBLIC_SITE_URL=https://www.example.com
# Google Analytics 4 measurement ID (leave empty to disable)
NEXT_PUBLIC_GA_ID=
# Google Search Console HTML-tag verification token (leave empty to disable)
NEXT_PUBLIC_GSC_VERIFICATION=
# Where inquiries are delivered. Any HTTPS endpoint that accepts JSON (Formspree, Make, Zapier, your CMS...)
INQUIRY_WEBHOOK_URL=
